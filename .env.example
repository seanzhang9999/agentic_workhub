# Token after /wiki/ in the root page URL.
AWIKI_ROOT_NODE_TOKEN=wikcn_REPLACE_ME
AWIKI_JOURNAL_ROOT_NODE_TOKEN=
PUBLIC_BASE_URL=https://gateway.example.com

# Optional, additive document links. Set only to your verified tenant origin.
AWIKI_FEISHU_BASE_URL=
AWIKI_LOCAL_VIEWER_BASE_URL=
HOST=127.0.0.1
PORT=8787
LARKSUITE_CLI_CONFIG_DIR=/data/lark-cli
LARK_CLI_WORK_DIR=/app/tmp
RECEIPT_DB_PATH=/data/gateway/receipts.sqlite
MAX_TREE_DEPTH=8
MAX_TREE_NODES=500
MAX_MARKDOWN_BYTES=500000
MAX_IMAGE_BYTES=10485760
LARK_TIMEOUT_MS=90000
