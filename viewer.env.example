# Independent viewer only. Never put these into the Gateway or Tunnel agent.
# Copy to viewer.env (ignored by Git), leave disabled until console setup is done.
AWIKI_DOCS_COMPONENT_ENABLED=false
AWIKI_DOCS_APP_ID=
# Absolute path to a user-provisioned, user-owned 600 file outside this repository.
# File contains only this web app's App Secret, NOT a CLI token/configuration.
AWIKI_DOCS_APP_SECRET_FILE=

# Use the same real coordinator ID in the viewer and collector CLI environment.
AWIKI_COORDINATOR_THREAD_ID=
AWIKI_COLLECTION_DB=
